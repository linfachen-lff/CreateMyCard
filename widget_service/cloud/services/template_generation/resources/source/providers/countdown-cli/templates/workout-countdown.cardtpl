#Template("WorkoutCountdown@1", {
  capability: "GetCountdownDays",
  description: "倒数日数据提供方交付的运动倒计时概览",
  domainTags: ["workout", "countdown", "sport"],
  compatibleThemeProfileIds: ["race-sunrise-action", "race-night-violet"],
  allowedParentComponents: ["Column", "Row", "List", "Stack"],
  bindings: { days: { path: "/countdownDays", type: "integer" } },
  params: {
    sourceIcon: { type: "string", kind: "asset", semanticTags: ["sport"] }
  },
  limits: { maxNodes: 8, maxDepth: 4 }
})

#Variant("countdown", { sizes: ["2x2", "2x4"], roles: ["hero"], requires: ["days"] })
Column("compact", {
  _advancedComponent: "WorkoutOverview", width: "matchParent", height: "matchParent",
  itemMargin: 4, justifyContent: "spaceBetween", alignItems: "start",
  constraintSize: { minWidth: 0, minHeight: 0 }
},
  Row("between", { width: "matchParent", itemMargin: 4, justifyContent: "start", alignItems: "top", constraintSize: { minWidth: 0, minHeight: 0 } },
    IfParam("sourceIcon",
      Image(Asset("sourceIcon"), "icon", { width: 20, height: 20, objectFit: "contain", flexShrink: 0 })
    ),
    Text("运动倒计时", "subtitle", { width: "matchParent", fontSize: 12, fontWeight: 500, fontColor: "#E6000000", maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } })
  ),
  Row("between", { width: "matchParent", itemMargin: 4, justifyContent: "start", alignItems: "bottom", constraintSize: { minWidth: 0, minHeight: 0 } },
    Text(Bind("days"), "title", { fontSize: 38, fontWeight: 800, fontColor: "#FFFFFFFF", maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } }),
    Text("天", "subtitle", { fontSize: 12, fontWeight: 500, fontColor: "#E6000000", maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } })
  )
)
#EndVariant
#EndTemplate
