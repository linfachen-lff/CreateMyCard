{
  "name": "generateWidgetCardTerseDslNested2",
  "transport": "websocket",
  "path": "/api/v1/ws/tools/generateWidgetCardTerseDslNested2",
  "description": "使用 UI Brief、整卡置信度路由和 CardPlan 局部 Template 融合生成标准 A2UI artifact。",
  "messageEnvelope": {
    "type": "object",
    "required": ["content", "deviceInfo", "session"],
    "properties": {
      "content": {
        "type": "object",
        "requiredProperties": ["userQuery", "title", "description"],
        "properties": {
          "userQuery": {"type": "string", "minLength": 1},
          "sourceArtifactUrl": {
            "type": "string",
            "required": false,
            "description": "上一轮完整 artifact URL；缺失表示首次生成，非空值表示基于 designcompactdsl 中的 Terse Design Token 编辑。"
          },
          "size": {"type": "string", "enum": ["2x2", "2x4"], "default": "2x2"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "candidateDataBindings": {
            "type": "CandidateDataBinding[]",
            "description": "候选数据能力；混合编译器只允许引用裁决后的 TaskSpec 路径。"
          },
          "candidateEventCandidates": {
            "type": "CandidateEventCandidate[]",
            "description": "候选点击事件；Template Action 最终绑定到裁决后的完整 call/args。"
          },
          "candidateAssetIds": {
            "type": "string[]",
            "description": "可选本地素材 ID；模型只能使用有效素材对应的本地路径。"
          },
          "options": {
            "type": "object",
            "required": false,
            "description": "生产调用方不传。仅 local/test 可在服务开关开启且 token 校验通过时强制混合路线。",
            "properties": {
              "allowDegradation": {"type": "boolean", "default": true},
              "forceHybridTemplate": {"type": "boolean", "default": false},
              "testAuthorization": {"type": "string", "required": false}
            }
          }
        }
      },
      "deviceInfo": {"type": "object"},
      "session": {"type": "object"},
      "userAuth": {"type": "object"},
      "utterance": {"type": "object"}
    }
  },
  "output": {
    "description": "华为流处理插件 start/partial/command/final 包络；command 的 content 指令包含 cardId 和 size。"
  }
}
